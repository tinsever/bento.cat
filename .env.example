# Copy to .env.local for development. Production values go in your host's settings.

# Convex deployment URL (from `bunx convex dev` or the Convex dashboard)
PUBLIC_CONVEX_URL=

# Optional for Convex Cloud; required for custom domains or self-hosted deployments.
# HTTP actions use a different URL from the query/mutation API.
PUBLIC_CONVEX_SITE_URL=

# Clerk publishable key (pk_test_… in development, pk_live_… in production)
VITE_CLERK_PUBLISHABLE_KEY=

# Disable the Google button until the production instance has its own OAuth credentials.
PUBLIC_GOOGLE_SIGN_IN_ENABLED=true

# Set on the Convex deployment, not here:
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-clerk-frontend-api>
#   bunx convex env set CLERK_SECRET_KEY <your-clerk-secret-key>
#   bunx convex env set CLERK_WEBHOOK_SIGNING_SECRET <your-webhook-signing-secret>
# Optional: email owners when someone joins a subscribe tile (https://brevo.com).
# Without BREVO_API_KEY no email is sent; owners still see subscribers in the editor.
#   bunx convex env set BREVO_API_KEY <your-brevo-api-key>
#   bunx convex env set MAIL_FROM hello@your-verified-domain   (defaults to hello@bento.cat)
#   bunx convex env set MAIL_FROM_NAME "Your name"              (defaults to bento.cat)
#   bunx convex env set SITE_URL https://your-domain   (defaults to https://bento.cat)
# Add a Clerk user.deleted webhook pointing to https://<deployment>.convex.site/clerk-webhook.
# Account deletion failures appear in Convex scheduled-function logs and
# accounts:pendingDeletions. Configure Convex error monitoring for operator alerts.
