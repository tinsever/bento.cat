{
	"name": "bento-cat",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "bun --bun vp build",
		"start": "bun build/index.js",
		"test": "vp test",
		"test:watch": "vp test watch",
		"check": "vp check && bun run test && bun run build",
		"check:production": "bun scripts/check-production.mjs",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"seed": "bun scripts/seed.mjs",
		"convex": "convex dev",
		"deploy:convex": "convex deploy",
		"lint": "vp lint",
		"format": "vp fmt"
	},
	"dependencies": {
		"@clerk/backend": "^3.22.0",
		"@clerk/clerk-js": "^6.37.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"convex": "^1.46.0",
		"maplibre-gl": "^6.12.0",
		"parse5": "^8.0.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"convex-test": "^0.0.60",
		"svelte": "^5.56.7",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	}
}
